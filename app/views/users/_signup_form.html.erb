<!-- app/views/users/_signup_form.html.erb -->
<h1 class="text-4xl font-bold mt-4 mb-8 text-center">
  <%= t('users.new_modal.title') %>
</h1>
<div id="signup_flash">
  <%= render 'shared/flash_message' %>
</div>
<%= form_with model: @user, url: create_signup_path, method: :post, data: { turbo: false } do |f| %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  
  <% unless current_user&.guest? %>
    <div class="flex items-center justify-center mb-8">
      <%= link_to auth_at_provider_path(provider: :google), method: :post, class: "btn-google", data: { turbo: false } do %>
        <img class="w-8 h-8" src="https://www.svgrepo.com/show/475656/google-color.svg" loading="lazy" alt="google logo">
        <span class="text-xl">Googleで新規登録<br class="md:hidden">またはログイン</span>
      <% end %>
    </div>
    <div class="divider"><%= t('defaults.or') %></div>
  <% end %>

  <%= render 'shared/error_messages', object: f.object %>

  <div class="card-body mx-auto">
    <div class="form-control mb-2">
      <%= f.label :email, class: "label-text text-lg font-semibold mb-1" %>
      <%= f.email_field :email, placeholder: "example@watune.com", class: "input input-bordered input-info text-lg", required: true, autocomplete: "email" %>
    </div>
    <div class="form-control mb-2">
      <%= f.label :password, class: "label-text text-lg font-semibold mb-1" do %>
        パスワード <span class="text-base">※8文字以上</span>
      <% end %>
      <%= f.password_field :password, class: "input input-bordered input-info text-lg", required: true, autocomplete: "password" %>
    </div>
    <div class="form-control mb-2">
      <%= f.label :username_slug, "ユーザー名（自分のURL）", class: "label-text text-lg font-semibold mb-1" %>
      <div class="flex items-center">
        <div class="flex-none text-lg text-gray-600 mx-1">https://www.watune.com/</div>
        <%= f.text_field :username_slug, placeholder: "self_url_123", id: "new_username", class: "input input-bordered input-info text-lg", required: true %>
      </div>
      <div class="flex-none text-md text-gray-600 mx-1">・3文字以上15文字以内</div>
      <div class="flex-none text-md text-gray-600 mx-1">・英数字または_(アンダースコア)のみ使用可能</div>
    </div>
    <div class="form-control mt-4">
      <%= f.submit "登録完了", class: "btn btn-outline btn-accent text-xl" %>
    </div>
    <p class="text-base mt-4">
      Watuneのご利用で、
      <%= link_to '利用規約', tou_modal_path, class: "btn-link", method: :get, data: { turbo_frame: "tou_modal" } %> と
      <%= link_to 'プライバシーポリシー', privacy_modal_path, class: "btn-link", method: :get, data: { turbo_frame: "privacy_modal" } %> が適用されます。
    </p>
  </div>
<% end %>

<div class='text-center text-base text-gray-600'>
  <%= link_to 'ログインページへ', new_login_modal_path, class: "btn-link text-lg", method: :get, data: { turbo_frame: "login_modal", action: "click->signup-modal#closeModal" } %>
</div>
