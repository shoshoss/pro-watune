<% if @user.errors.any? %>
  <%= turbo_stream.replace 'signup_flash', partial: 'shared/flash_message', locals: { flash: { danger: t('flash_messages.users.signup_failure') } } %>
  <%= turbo_stream.replace 'error_messages', partial: 'shared/error_messages', locals: { object: @user } %>
<% else %>
  <%= turbo_stream.append 'main-content' do %>
    <%= tag.script "window.Turbo.visit('#{profile_show_path(username_slug: @user.username_slug)}');" %>
  <% end %>
  <%= turbo_stream.update 'no-sidebar', partial: 'shared/sidebar' %>
  <%= turbo_stream.update 'no-widget', partial: 'shared/widget', locals: { users: @recent_users, pagy: @pagy } %>
  <%= turbo_stream.update 'before_login_header', partial: 'shared/header' %>
  <%= turbo_stream.remove 'guest-update' %>
<% end %>
