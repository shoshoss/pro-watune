<% if @user.errors.any? %>
  <%= turbo_stream.replace 'flash', partial: 'shared/flash_message', locals: { flash: { danger: t('flash_messages.users.guest_login_failure') } } %>
<% else %>
  <%= turbo_stream.append 'main-content' do %>
    <%= tag.script "window.Turbo.visit('#{profile_show_path(username_slug: @user.username_slug)}');" %>
  <% end %>
  <%= turbo_stream.replace 'no-sidebar', partial: 'shared/sidebar' %>
  <%= turbo_stream.replace 'no-widget', partial: 'shared/widget' %>
  <%= turbo_stream.replace 'before_login_header', partial: 'shared/header' %>
<% end %>
