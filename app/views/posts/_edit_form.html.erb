<%# app/views/posts/_edit_form.html.erb %>
  <div class="sticky top-0 z-10 mt-2 flex flex mx-auto justify-between bg-white px-[16px] h-[30px] sm:h-[53px] border-b">
        <!-- 戻るボタン -->
        <%= render 'shared/back_edit_button' %>
        <div class="flex justify-center items-center flex-grow">
          <h1 class="text-[17px] sm:text-xl font-bold text-center">投稿の編集</h1>
        </div>
        <div class="invisible w-[56px] h-[30px] sm:h-[53px]">ダミー</div>
      </div>

  <%= form_with model: post, method: :patch, data: { turbo: false }  do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <div class="card-body mx-auto">
      <!-- 送信先設定 -->
      <% current_privacy = params[:privacy] || post.privacy %>
    
      <% if post.reply? %>
        <div class="form-control pt-2">
          <p class="font-semibold text-base text-black">返信先の変更はできません。</p>
        </div>
      <% elsif current_privacy == 'selected_users' %>
        <div class="form-control pt-2">
          <p class="font-semibold text-base text-black">ユーザーの選択の変更はできません。</p>
        </div>
      <% else %>
        <%= turbo_frame_tag "sending_privacy" do %>
          <div class="form-control">
            <label for="post_privacy" class="block text-lg font-semibold">送信先</label>
            <div class="flex flex-col space-y-2 pt-2">
              <div class="flex space-x-4">
                <div class="flex-1 text-center">
                  <%= link_to '自分', 
                      edit_post_path(post, privacy: 'only_me'),
                      class: "btn-choice #{active_bottom('only_me')} w-full #{'btn-choice-only_me-active' if current_privacy == 'only_me'}",
                      data: { turbo_frame: "sending_privacy", turbo: true } %>
                  <p class="text-sm text-gray-600 mt-1">自分のみが<br class="sm:hidden">閲覧可能</p>
                </div>

                <div class="flex-1 text-center">
                  <%= link_to '全体',
                      edit_post_path(post, privacy: 'open'),
                      class: "btn-choice #{active_bottom('open')} w-full #{'btn-choice-open-active' if current_privacy == 'open'}",
                      data: { turbo_frame: "sending_privacy", turbo: true } %>
                  <p class="text-sm text-gray-600 mt-1">ホームに<br class="sm:hidden">公開され<br class="md:hidden">全ての<br class="sm:hidden">ユーザーが<br class="sm:hidden">閲覧可能</p>
                </div>
              </div>
            </div>
            <input type="hidden" name="post[privacy]" id="post_privacy" value="<%= current_privacy %>">
          </div>
        <% end %>
      <% end %>

      <!-- カテゴリー設定 -->
      <div class="form-control pt-2">
        <%= f.label :fixed_category, 'カテゴリー', class: "block text-lg font-semibold" %>
        <%= f.select :fixed_category, 
            Post.fixed_categories_i18n.invert.map { |key, value| [key, value] }, 
            { include_blank: false }, 
            class: "block mt-1 p-2 text-base border-2 border-gray-300 rounded-lg" %>
      </div>

      <div class="form-control pt-2">
        <%= f.label :custom_category, class: "block text-lg font-semibold" do %>
          追加カテゴリー <span class="text-base font-normal">※50文字までOK!</span>
        <% end %>
        <%= f.text_field :custom_category, 
            class: "block mt-1 p-2 text-base border-2 border-gray-300 rounded-lg", 
            placeholder: "必要に応じて入力" %>
      </div>

      <!-- 投稿内容 -->
      <div class="form-control pt-2">
        <%= f.label :body, class: "block text-lg font-semibold" %>
        <%= f.text_area :body, 
            class: "block mt-1 p-2 text-base md:text-lg border-2 border-gray-300 rounded-lg focus:outline-none focus:ring focus:border-sky-400-accent-accent resize-none overflow-y-auto", 
            rows: "10", 
            style: "resize: vertical;" %>
      </div>

      <% if post.audio.attached? %>
        <div class="form-control pt-4">
          <label class="block text-lg font-semibold">音声ファイル</label>
          <div class="bg-gray-50 p-4 rounded-lg mt-1">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
              <div class="text-sm text-gray-600">
                <span class="font-medium">現在のファイル:</span>
                <span class="uppercase"><%= post.audio.content_type.split('/').last %></span>
                <span>(<%= number_to_human_size(post.audio.byte_size) %>)</span>
              </div>
              
              <% if post.audio.content_type != 'audio/mpeg' %>
                <%= button_to convert_to_mp3_post_path(post),
                    class: "w-full sm:w-auto btn btn-sm bg-blue-500 hover:bg-blue-700 text-white font-bold py-1 px-3 rounded" do %>
                  MP3に変換
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="form-control mt-4 lg:mt-6">
        <%= f.submit nil, class: "btn text-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded disabled:opacity-50" %>
      </div>
  <% end %>
